# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS ORACLE
# ==========================================
# Servidor Oracle donde se encuentra la base de datos
DB_HOST=servidor.dominio.com

# Puerto en el que escucha Oracle (por defecto 1521)
DB_PORT=1521

# Nombre del servicio Oracle (SID o SERVICE_NAME)
DB_SERVICE=nombre_servicio

# Usuario de base de datos
DB_USER=usuario_bd

# Contraseña del usuario de base de datos
DB_PASS=contraseña_segura

# ==========================================
# CONFIGURACIÓN MICROSOFT/DYNAMICS
# ==========================================
# URL del endpoint de autenticación de Microsoft
# Típicamente: https://login.microsoftonline.com
MICROSOFT_ENDPOINT=https://login.microsoftonline.com

# ID del tenant de Azure AD
# Se encuentra en Azure Portal > Azure Active Directory > Propiedades
MICROSOFT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID de la aplicación registrada en Azure AD
# Se encuentra en Azure Portal > Registros de aplicaciones
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secreto de la aplicación en Azure AD
# Generado en Azure Portal > Registros de aplicaciones > Certificados y secretos
MICROSOFT_CLIENT_SECRET=tu_cliente_secreto_aqui

# Scope para acceso a Dynamics (permisos)
# Formato: https://{nombre-instancia}.dynamics.com/.default
MICROSOFT_SCOPE=https://nombre-instancia.dynamics.com/.default

# URL del endpoint de la API de Dynamics 365
# Formato: https://{nombre-instancia}.api.dynamics.com
DYNAMICS_ENDPOINT=https://nombre-instancia.api.dynamics.com

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. Reemplazar todos los valores con los valores reales
# 2. No compartir este archivo con datos sensibles
# 3. Añadir .env a .gitignore para evitar compartir credenciales
# 4. Las contraseñas deben cumplir con la política de seguridad
# 5. Usar variables de entorno del sistema para entornos de producción
